# ============================================================================
# PostgreSQL MCP Server - Environment Configuration
# ============================================================================
# Copy this file to .env and configure it with your actual values.
# DO NOT commit .env to version control - it contains sensitive credentials.
#
# Every variable listed here is read by `pg_mcp.config.settings.Settings`.
# ============================================================================


# ============================================================================
# PRIMARY DATABASE (required)
# ============================================================================
# The primary database is always available and is auto-selected when a query
# does not pass an explicit `database` argument.

# Database host (IP address or hostname). Examples: localhost, db.example.com
DATABASE_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DATABASE_PORT=5432

# Database name to connect to
DATABASE_NAME=blog_small

# Database user. SECURITY: use a read-only user in production (see README.md).
DATABASE_USER=postgres

# Database password. SECURITY: never commit this to version control.
DATABASE_PASSWORD=postgres

# --- Connection pool (per database) ---
DATABASE_MIN_POOL_SIZE=5
DATABASE_MAX_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30
DATABASE_COMMAND_TIMEOUT=30


# ============================================================================
# ADDITIONAL DATABASES (optional, enables real multi-database routing)
# ============================================================================
# A JSON array. Each entry creates its own connection pool, its own security
# policy and its own executor. Every entry must have a unique `name`; that name
# is what callers pass as the `database` argument of the `query` tool
# (use the `list_databases` tool to discover them).
#
# DATABASES=[{"name":"analytics","host":"analytics.internal","user":"pg_mcp_ro","password":"secret"},{"name":"sales","host":"sales.internal","port":5433,"user":"pg_mcp_ro","password":"secret","max_pool_size":10}]
#
# Leave unset (or empty) to run in single-database mode.


# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================

# OpenAI API key (required). Get one from https://platform.openai.com/api-keys
# SECURITY: never commit this to version control.
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Model used for SQL generation and result validation
OPENAI_MODEL=gpt-5.2-mini

# Maximum tokens for LLM requests
OPENAI_MAX_TOKENS=32000

# Model temperature (0.0 = deterministic - recommended for SQL)
OPENAI_TEMPERATURE=0.0

# API request timeout in seconds
OPENAI_TIMEOUT=30

# Optional OpenAI-compatible base URL (proxies, gateways, local test doubles)
# OPENAI_BASE_URL=https://my-gateway.internal/v1


# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Allow write operations (INSERT, UPDATE, DELETE, MERGE)
# SECURITY: keep false in production. When false, queries also run inside a
# read-only transaction, so the database enforces it too.
SECURITY_ALLOW_WRITE_OPERATIONS=false

# Comma-separated (or JSON array) list of blocked PostgreSQL functions.
# These are merged with a built-in list of dangerous functions.
SECURITY_BLOCKED_FUNCTIONS=pg_sleep,pg_read_file,pg_write_file,lo_import,lo_export,pg_ls_dir,pg_read_binary_file,pg_stat_file

# Tables that may never be referenced. Bare (`secret_data`) or schema-qualified
# (`public.secret_data`) entries both work.
# SECURITY_BLOCKED_TABLES=secret_data,payment_cards

# Columns that may never be read. Bare (`password_hash`), table-qualified
# (`users.password_hash`) or schema-qualified (`public.users.password_hash`).
# SECURITY_BLOCKED_COLUMNS=password_hash,api_key

# Allow EXPLAIN. Read-only, but it leaks query plans, so it is off by default.
SECURITY_ALLOW_EXPLAIN=false

# Maximum rows returned per query
SECURITY_MAX_ROWS=10000

# Maximum query execution time in seconds (statement_timeout)
SECURITY_MAX_EXECUTION_TIME=30

# Role to SET ROLE into for every query (recommended: a read-only role)
# SECURITY_READONLY_ROLE=pg_mcp_readonly

# search_path forced for every query
SECURITY_SAFE_SEARCH_PATH=public

# Per-database security overrides (JSON object keyed by database name).
# Blocked tables/columns/functions are ADDITIVE: an override can only tighten
# the global policy, never loosen it. allow_explain/max_rows/readonly_role
# override the global value when present.
#
# SECURITY_PER_DATABASE={"sales":{"blocked_tables":["margin_targets"],"max_rows":500},"analytics":{"readonly_role":"analytics_ro"}}


# ============================================================================
# VALIDATION CONFIGURATION
# ============================================================================

# Maximum question length in characters (checked before any LLM call)
VALIDATION_MAX_QUESTION_LENGTH=10000

# Results whose confidence is below this value are flagged in the response
# (marked `low_confidence: true`) but are still returned.
VALIDATION_MIN_CONFIDENCE_SCORE=70

# Enable LLM-based result validation
VALIDATION_ENABLED=true

# Number of sample rows sent to the validator
VALIDATION_SAMPLE_ROWS=5

# Result validation timeout in seconds
VALIDATION_TIMEOUT_SECONDS=10

# Minimum confidence for `is_acceptable` in the result validation payload
VALIDATION_CONFIDENCE_THRESHOLD=70


# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_ENABLED=true
CACHE_SCHEMA_TTL=3600
CACHE_MAX_SIZE=100


# ============================================================================
# RESILIENCE CONFIGURATION
# ============================================================================

# Retry/backoff applied to transient LLM and database failures.
# The delay before retry N is min(RETRY_DELAY * BACKOFF_FACTOR^N, MAX_RETRY_DELAY),
# plus/minus RETRY_JITTER as a fraction of that delay.
RESILIENCE_MAX_RETRIES=3
RESILIENCE_RETRY_DELAY=1.0
RESILIENCE_BACKOFF_FACTOR=2.0
RESILIENCE_MAX_RETRY_DELAY=30.0
RESILIENCE_RETRY_JITTER=0.1

# Circuit breaker protecting LLM calls
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=60

# Concurrency limiting (applied to the real request path).
# A request that cannot get a slot within RATE_LIMIT_TIMEOUT fails fast with
# error code `rate_limit_exceeded`.
RESILIENCE_RATE_LIMIT_ENABLED=true
RESILIENCE_MAX_CONCURRENT_QUERIES=10
RESILIENCE_MAX_CONCURRENT_LLM_CALLS=5
RESILIENCE_RATE_LIMIT_TIMEOUT=10.0


# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Prometheus metrics endpoint (GET /metrics)
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PORT=9090

# Logging. NOTE: logs always go to STDERR because stdout carries the MCP
# JSON-RPC frames.
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=json


# ============================================================================
# ENVIRONMENT
# ============================================================================

# development | staging | production
ENVIRONMENT=development


# ============================================================================
# CONFIGURATION VALIDATION CHECKLIST
# ============================================================================
# [ ] Database credentials are correct (test with: psql -h $HOST -U $USER -d $NAME)
# [ ] OPENAI_API_KEY is valid and has credit
# [ ] SECURITY_BLOCKED_TABLES / SECURITY_BLOCKED_COLUMNS cover your sensitive objects
# [ ] SECURITY_PER_DATABASE adds extra restrictions for sensitive databases
# [ ] SECURITY_ALLOW_WRITE_OPERATIONS=false and a read-only user is used
# [ ] Resource limits (max_rows, max_execution_time) match your requirements
# [ ] Logging and metrics are configured for your monitoring setup
# [ ] .env is NOT committed to version control (.gitignore contains .env)
